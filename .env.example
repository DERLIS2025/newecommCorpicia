# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# WARNING: This key can bypass Row Level Security. NEVER expose it to the browser.
# DO NOT commit real values here.
SUPABASE_SERVICE_ROLE_KEY=

# Data Source Switch (static | supabase)
NEXT_PUBLIC_DATA_SOURCE=static

# Site URL (e.g., http://localhost:3000 or production URL)
NEXT_PUBLIC_SITE_URL=

# WhatsApp Contact Number
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Google Tag Manager / Analytics (Optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GADS_ID=
NEXT_PUBLIC_GSC_VERIFICATION=
